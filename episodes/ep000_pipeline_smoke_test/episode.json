        "text": "What if you could pause the whole world for one minute?"
      },
      {
        "id": "v02",
        "scene": "s02",
        "offset": 0.2,
        "path": "audio/vo/v02.wav",
        "text": "Everyone freezes. Cars, birds, even your neighbour's sneeze."
      },
      {
        "id": "v03",
        "scene": "s03",
        "offset": 0.25,
        "path": "audio/vo/v03.wav",
        "text": "Sounds fun, until you notice something."
      },
      {
        "id": "v04",
        "scene": "s04",
        "offset": 0.2,
        "path": "audio/vo/v04.wav",
        "text": "One minute for the world is still one minute of *your* life."
      },
      {
        "id": "v05",
        "scene": "s05",
        "offset": 0.3,
        "path": "audio/vo/v05.wav",
